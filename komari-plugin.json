{
  "$schema": "./node_modules/@komari-monitor/plugin-sdk/schema/komari-plugin.schema.json",
  "name": {
    "zh-CN": "IPQA 告警报告",
    "zh_CN": "IPQA 告警报告",
    "en": "IPQA Alert Report"
  },
  "short": "ipqa-alert-report",
  "description": {
    "zh-CN": "对于安装了开源项目 IP-Quality-Archive 的 VPS，通过 Komari 通知渠道发送 IP 质量的告警通知。",
    "zh_CN": "对于安装了开源项目 IP-Quality-Archive 的 VPS，通过 Komari 通知渠道发送 IP 质量的告警通知。",
    "en": "Sends IP quality alert notifications via Komari notification channels for VPS nodes with the open-source project IP-Quality-Archive installed."
  },
  "version": "0.2.0",
  "komari": ">=1.4.3",
  "entry": "script.js",
  "icon": "assets/icon.svg",
  "author": "Chen017",
  "permissions": {
    "node": true,
    "allowSystemRPC": true,
    "allowRoutes": true,
    "timeout": 120
  },
  "configuration": {
    "type": "managed",
    "name": "IPQA 告警报告设置",
    "data": [
      {
        "name": {
          "zh-CN": "<div style=\"margin: 0 0 12px 0; padding: 12px 16px; background: rgba(239, 68, 68, 0.08); border-left: 4px solid #dc2626; border-radius: 4px;\"><div style=\"color: #dc2626; font-weight: 700; font-size: 14px; margin-bottom: 6px;\">⚠️ 插件仅适用于已经安装了 <a href=\"https://github.com/Chen017/IP-Quality-Archive\" target=\"_blank\" style=\"color: #dc2626; text-decoration: underline;\">IP-Quality-Archive</a> 的 VPS，若未安装请先前往安装。</div><div style=\"font-size: 13px; color: #475569; line-height: 1.6;\">• <b>IPQA 项目链接</b>：<a href=\"https://github.com/Chen017/IP-Quality-Archive\" target=\"_blank\" style=\"color: #2563eb; text-decoration: underline;\">https://github.com/Chen017/IP-Quality-Archive</a><br>• <b>插件效果预览</b>：<a href=\"https://github.com/Chen017/komari-plugin-ipqa-alert-report\" target=\"_blank\" style=\"color: #2563eb; text-decoration: underline;\">https://github.com/Chen017/komari-plugin-ipqa-alert-report</a></div></div><div style=\"margin: 4px 0 12px 0; padding: 12px; background: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 8px;\"><div style=\"font-weight: 600; font-size: 14px; margin-bottom: 4px; color: #1d4ed8;\">🧪 手动测试运行</div><div style=\"font-size: 13px; color: #64748b; margin-bottom: 10px;\">点击下方按钮将立即连接已配置的 VPS 节点，读取 alerts.log 并按告警规则生成汇总报告并发送通知。</div><button type=\"button\" id=\"ipqa-quick-test-btn\" style=\"padding: 7px 16px; background-color: #2563eb; color: #ffffff; border: none; border-radius: 6px; font-weight: 500; font-size: 13px; cursor: pointer; transition: all 0.2s;\" onclick=\"(function(btn){ const tip = document.getElementById('ipqa-quick-test-tip'); btn.disabled=true; btn.style.opacity='0.7'; btn.innerText='⏳ 正在获取VPS日志...'; if(tip){ tip.style.color='#2563eb'; tip.innerText='正在向节点下发任务，请稍候（约需 5-15 秒）...'; } fetch('/api/plugin/ipqa-alert-report/test', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ window: 'today_now' }) }).then(async res => { const data = await res.json().catch(() => ({})); btn.disabled=false; btn.style.opacity='1'; btn.innerText='⚡ 立即测试运行'; if (res.ok && data.success) { if(tip){ tip.style.color='#16a34a'; tip.innerText='✅ ' + (data.message || '测试完成'); } } else { if(tip){ tip.style.color='#dc2626'; tip.innerText='❌ ' + (data.message || data.error || '测试失败'); } } }).catch(err => { btn.disabled=false; btn.style.opacity='1'; btn.innerText='⚡ 立即测试运行'; if(tip){ tip.style.color='#dc2626'; tip.innerText='❌ 请求失败: ' + err.message; } }); })(this)\">⚡ 立即测试运行</button><div id=\"ipqa-quick-test-tip\" style=\"margin-top: 8px; font-size: 13px; font-weight: 500;\"></div></div>",
          "zh_CN": "<div style=\"margin: 0 0 12px 0; padding: 12px 16px; background: rgba(239, 68, 68, 0.08); border-left: 4px solid #dc2626; border-radius: 4px;\"><div style=\"color: #dc2626; font-weight: 700; font-size: 14px; margin-bottom: 6px;\">⚠️ 插件仅适用于已经安装了 <a href=\"https://github.com/Chen017/IP-Quality-Archive\" target=\"_blank\" style=\"color: #dc2626; text-decoration: underline;\">IP-Quality-Archive</a> 的 VPS，若未安装请先前往安装。</div><div style=\"font-size: 13px; color: #475569; line-height: 1.6;\">• <b>IPQA 项目链接</b>：<a href=\"https://github.com/Chen017/IP-Quality-Archive\" target=\"_blank\" style=\"color: #2563eb; text-decoration: underline;\">https://github.com/Chen017/IP-Quality-Archive</a><br>• <b>插件效果预览</b>：<a href=\"https://github.com/Chen017/komari-plugin-ipqa-alert-report\" target=\"_blank\" style=\"color: #2563eb; text-decoration: underline;\">https://github.com/Chen017/komari-plugin-ipqa-alert-report</a></div></div><div style=\"margin: 4px 0 12px 0; padding: 12px; background: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 8px;\"><div style=\"font-weight: 600; font-size: 14px; margin-bottom: 4px; color: #1d4ed8;\">🧪 手动测试运行</div><div style=\"font-size: 13px; color: #64748b; margin-bottom: 10px;\">点击下方按钮将立即连接已配置的 VPS 节点，读取 alerts.log 并按告警规则生成汇总报告并发送通知。</div><button type=\"button\" id=\"ipqa-quick-test-btn\" style=\"padding: 7px 16px; background-color: #2563eb; color: #ffffff; border: none; border-radius: 6px; font-weight: 500; font-size: 13px; cursor: pointer; transition: all 0.2s;\" onclick=\"(function(btn){ const tip = document.getElementById('ipqa-quick-test-tip'); btn.disabled=true; btn.style.opacity='0.7'; btn.innerText='⏳ 正在获取VPS日志...'; if(tip){ tip.style.color='#2563eb'; tip.innerText='正在向节点下发任务，请稍候（约需 5-15 秒）...'; } fetch('/api/plugin/ipqa-alert-report/test', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ window: 'today_now' }) }).then(async res => { const data = await res.json().catch(() => ({})); btn.disabled=false; btn.style.opacity='1'; btn.innerText='⚡ 立即测试运行'; if (res.ok && data.success) { if(tip){ tip.style.color='#16a34a'; tip.innerText='✅ ' + (data.message || '测试完成'); } } else { if(tip){ tip.style.color='#dc2626'; tip.innerText='❌ ' + (data.message || data.error || '测试失败'); } } }).catch(err => { btn.disabled=false; btn.style.opacity='1'; btn.innerText='⚡ 立即测试运行'; if(tip){ tip.style.color='#dc2626'; tip.innerText='❌ 请求失败: ' + err.message; } }); })(this)\">⚡ 立即测试运行</button><div id=\"ipqa-quick-test-tip\" style=\"margin-top: 8px; font-size: 13px; font-weight: 500;\"></div></div>",
          "en": "<div style=\"margin: 0 0 12px 0; padding: 12px 16px; background: rgba(239, 68, 68, 0.08); border-left: 4px solid #dc2626; border-radius: 4px;\"><div style=\"color: #dc2626; font-weight: 700; font-size: 14px; margin-bottom: 6px;\">⚠️ This plugin is ONLY for VPS nodes with <a href=\"https://github.com/Chen017/IP-Quality-Archive\" target=\"_blank\" style=\"color: #dc2626; text-decoration: underline;\">IP-Quality-Archive</a> installed. Please install it first if not installed.</div><div style=\"font-size: 13px; color: #475569; line-height: 1.6;\">• <b>IPQA Repository & Installation</b>: <a href=\"https://github.com/Chen017/IP-Quality-Archive\" target=\"_blank\" style=\"color: #2563eb; text-decoration: underline;\">https://github.com/Chen017/IP-Quality-Archive</a><br>• <b>Plugin Preview</b>: <a href=\"https://github.com/Chen017/komari-plugin-ipqa-alert-report\" target=\"_blank\" style=\"color: #2563eb; text-decoration: underline;\">https://github.com/Chen017/komari-plugin-ipqa-alert-report</a></div></div><div style=\"margin: 4px 0 12px 0; padding: 12px; background: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 8px;\"><div style=\"font-weight: 600; font-size: 14px; margin-bottom: 4px; color: #1d4ed8;\">🧪 Manual Test Run</div><div style=\"font-size: 13px; color: #64748b; margin-bottom: 10px;\">Click to fetch alerts.log from configured VPS nodes and trigger alert notifications according to rules.</div><button type=\"button\" id=\"ipqa-quick-test-btn\" style=\"padding: 7px 16px; background-color: #2563eb; color: #ffffff; border: none; border-radius: 6px; font-weight: 500; font-size: 13px; cursor: pointer; transition: all 0.2s;\" onclick=\"(function(btn){ const tip = document.getElementById('ipqa-quick-test-tip'); btn.disabled=true; btn.style.opacity='0.7'; btn.innerText='⏳ Fetching logs...'; if(tip){ tip.style.color='#2563eb'; tip.innerText='Running remote tasks, please wait (approx. 5-15s)...'; } fetch('/api/plugin/ipqa-alert-report/test', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ window: 'today_now' }) }).then(async res => { const data = await res.json().catch(() => ({})); btn.disabled=false; btn.style.opacity='1'; btn.innerText='⚡ Run Test Now'; if (res.ok && data.success) { if(tip){ tip.style.color='#16a34a'; tip.innerText='✅ ' + (data.message || 'Test finished'); } } else { if(tip){ tip.style.color='#dc2626'; tip.innerText='❌ ' + (data.message || data.error || 'Test failed'); } } }).catch(err => { btn.disabled=false; btn.style.opacity='1'; btn.innerText='⚡ Run Test Now'; if(tip){ tip.style.color='#dc2626'; tip.innerText='❌ Request error: ' + err.message; } }); })(this)\">⚡ Run Test Now</button><div id=\"ipqa-quick-test-tip\" style=\"margin-top: 8px; font-size: 13px; font-weight: 500;\"></div></div>"
        },
        "type": "textbox"
      },
      {
        "key": "enabled",
        "name": {
          "zh-CN": "启用 IPQA 告警报告",
          "zh_CN": "启用 IPQA 告警报告",
          "en": "Enable IPQA alert report"
        },
        "type": "switch",
        "default": true
      },
      {
        "key": "all_nodes",
        "name": {
          "zh-CN": "为全部节点启用",
          "zh_CN": "为全部节点启用",
          "en": "Enable for all nodes"
        },
        "type": "switch",
        "default": false,
        "help": "开启后忽略下方节点选择，将所有 Komari 节点纳入 IPQA 告警检查。仅建议所有节点都安装了 IPQA 时开启。"
      },
      {
        "key": "nodes",
        "name": {
          "zh-CN": "选择节点",
          "zh_CN": "选择节点",
          "en": "Select nodes"
        },
        "type": "nodes",
        "default": "[]",
        "help": "选择安装了 IP-Quality-Archive 的 VPS。"
      },
      {
        "name": {
          "zh-CN": "固定每天北京时间 07:00 汇总当天 00:00–07:00 的 IPQA 告警。IPQA 应已在北京时间 04:00 完成自动检测。",
          "zh_CN": "固定每天北京时间 07:00 汇总当天 00:00–07:00 的 IPQA 告警。IPQA 应已在北京时间 04:00 完成自动检测。",
          "en": "Runs daily at 07:00 Asia/Shanghai and summarizes IPQA alerts from 00:00 to 07:00. IPQA is expected to finish its scheduled check at 04:00 Asia/Shanghai."
        },
        "type": "textbox"
      },
      {
        "key": "sync_archives",
        "name": {
          "zh-CN": "同步 IPQA 历史归档",
          "zh_CN": "同步 IPQA 历史归档",
          "en": "Sync IPQA archives"
        },
        "type": "switch",
        "default": true,
        "help": "自动将节点上的 IP-Quality-Archive 历史归档同步到 Komari，供 Emerald Insights 展示 IP 质量概览和历史数据。"
      },
      {
        "key": "min_severity",
        "name": {
          "zh-CN": "最低通知等级",
          "zh_CN": "最低通知等级",
          "en": "Minimum severity"
        },
        "type": "select",
        "default": "INFO",
        "options": "INFO,WARNING,CRITICAL",
        "help": "最低通知严重等级：INFO 包含所有级别；WARNING 仅通知警告和严重；CRITICAL 仅通知严重告警。"
      },
      {
        "key": "ignore_initial_archive",
        "name": {
          "zh-CN": "忽略首次建档记录",
          "zh_CN": "忽略首次建档记录",
          "en": "Ignore initial archive event"
        },
        "type": "switch",
        "default": true,
        "help": "开启后自动过滤 IPQA 首次建档记录「首次完成数据存档监测」。"
      },
      {
        "key": "notify_collection_failures",
        "name": {
          "zh-CN": "采集失败时通知",
          "zh_CN": "采集失败时通知",
          "en": "Notify on collection failures"
        },
        "type": "switch",
        "default": true,
        "help": "当节点离线、Agent 超时或无法读取 alerts.log 时，是否发送采集异常通知。"
      },
      {
        "key": "template",
        "name": {
          "zh-CN": "通知模板",
          "zh_CN": "通知模板",
          "en": "Notification template"
        },
        "type": "richtext",
        "default": "",
        "help": "留空使用默认报告正文。支持占位符: {{date}}, {{time}}, {{message}}, {{alert_count}}, {{alert_nodes}}, {{critical_count}}, {{warning_count}}, {{info_count}}, {{failed_nodes}}, {{nodes}}。"
      }
    ]
  }
}
